{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/404",
      "/404/*",
      "/ferramentas",
      "/ferramentas/*",
      "/sobre",
      "/sobre/*",
      "/como-funciona",
      "/como-funciona/*",
      "/privacidade",
      "/privacidade/*",
      "/cookies",
      "/cookies/*",
      "/*.{css,js,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,map,txt,xml}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/favicon.png",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/llms.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    }
  ],
  "mimeTypes": {
    ".xml": "application/xml",
    ".txt": "text/plain"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404/index.html",
      "statusCode": 404
    }
  }
}
