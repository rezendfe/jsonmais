# Portal 100% front-end. Ads usam proxy local (dev) ou função SWA (prod).
#
# Copie para .env.local (não versionado):
# VITE_ADS_ENABLED=true
# ADS_ENABLED=true
# ADS_BASE_URL=https://YOUR-ADS-API.azurewebsites.net
# ADS_SISTEMA_KEY=your-system-key
#
# Nunca use VITE_ para a chave de sistema — ela não deve ir no bundle.
VITE_ADS_ENABLED=false
